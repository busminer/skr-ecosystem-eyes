# Server
HOST=127.0.0.1
PORT=4173

# Use a dedicated Solana provider URL for a public deployment.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: route only the heavy UserStake account scan to Alchemy.
# Keep the real API key in .env or the host's secret manager, never in git.
SOLANA_RPC_SCAN_URL=

# Public RPC-safe defaults. Lower only when your provider allows more throughput.
RPC_MIN_INTERVAL_MS=500
RPC_MAX_PAGES=1000
POLL_INTERVAL_MS=8000
METRICS_INTERVAL_MS=60000
QUEUE_INTERVAL_MS=900000
INITIAL_BACKFILL_LIMIT=25
SIGNATURE_PAGE_LIMIT=1000
SIGNATURE_MAX_PAGES=20

# SQLite keeps 35 days on disk while only recent rows stay in memory.
EVENT_DB_FILE=data/events.sqlite
EVENT_MEMORY_LIMIT=20000
EVENT_RETENTION_DAYS=35
ANALYTICS_REFRESH_MS=30000

# Public live-feed protection.
SSE_MAX_CLIENTS=100
